# ── LLM Provider ("gemini", "openai", or "anthropic") ────────────────
LLM_PROVIDER=gemini

# ── API Keys (only the one matching LLM_PROVIDER is required) ────────
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Application ──────────────────────────────────────────────────────
APP_NAME=Exam Prep Bot
APP_VERSION=1.0.0
DEBUG_MODE=false

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── CORS (comma-separated origins, restrict in production) ───────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Model (leave empty to use provider default) ──────────────────────
# Defaults: gemini → gemini-2.0-flash, openai → gpt-4o-mini, anthropic → claude-3-5-sonnet-20241022
MODEL_NAME=
MAX_TOKENS=1024
TEMPERATURE=0.3

# ── Document Processing ─────────────────────────────────────────────
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx
UPLOAD_DIR=./uploads

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
BATCH_SIZE=32

# ── Vector Database ──────────────────────────────────────────────────
USE_FAISS=true
FAISS_INDEX_PATH=./data/faiss_index

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.5
MIN_RELEVANCE_SCORE=0.3

# ── Intent Classification ────────────────────────────────────────────
INTENT_CLASSIFICATION_THRESHOLD=0.7
INTENT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Caching ──────────────────────────────────────────────────────────
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=300
CACHE_DIR=./cache
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./exam_prep_bot.db

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ── Development ──────────────────────────────────────────────────────
DEVELOPMENT_MODE=true
