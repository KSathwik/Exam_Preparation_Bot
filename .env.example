# ── LLM Provider ("gemini", "openai", or "anthropic") ────────────────
LLM_PROVIDER=gemini

# ── API Keys (only the one matching LLM_PROVIDER is required) ────────
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Application ──────────────────────────────────────────────────────
APP_NAME=Exam Prep Bot
APP_VERSION=1.0.0
DEBUG_MODE=false

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Must stay 1 — the vector store and chat history are process-local
# singletons with no cross-process coordination; >1 worker corrupts the
# on-disk FAISS index. main.py clamps this to 1 regardless, but don't rely
# on that — fix it here.
WORKERS=1

# ── CORS (comma-separated origins, restrict in production) ───────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Model (leave empty to use provider default) ──────────────────────
# Defaults: gemini → gemini-2.0-flash, openai → gpt-4o-mini, anthropic → claude-sonnet-5
MODEL_NAME=
MAX_TOKENS=2048
TEMPERATURE=0.3

# ── Document Processing ─────────────────────────────────────────────
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx
UPLOAD_DIR=./uploads

# ── Embeddings ───────────────────────────────────────────────────────
# Changing this on a deployment with an existing FAISS index requires a full
# reindex (re-upload all documents) — old and new embeddings aren't comparable.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384
BATCH_SIZE=32

# ── Vector Database ──────────────────────────────────────────────────
USE_FAISS=true
FAISS_INDEX_PATH=./data/faiss_index

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.5
MIN_RELEVANCE_SCORE=0.3

# Hybrid retrieval: weight given to dense/semantic score vs. lexical BM25
# score (1.0 = pure dense, 0.0 = pure BM25)
HYBRID_DENSE_WEIGHT=0.6

# Cross-encoder reranking of the merged candidate pool — opt-in, off by default
ENABLE_CROSS_ENCODER_RERANK=false
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Conversation memory (only meaningful when the Memory Agent runs with persist=True)
MEMORY_RELEVANCE_THRESHOLD=0.6
MEMORY_SUMMARIZE_EVERY_N_TURNS=10
MEMORY_SUMMARIZE_TOKEN_THRESHOLD=2000

# ── Intent Classification ────────────────────────────────────────────
INTENT_CLASSIFICATION_THRESHOLD=0.7
INTENT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Skip the reflection pass (a full second LLM call) when the draft already
# shows zero verified citations AND confidence is far below the hard-block
# floor — saves a whole round-trip on drafts that were always going to be
# blocked anyway. Narrow on purpose; see config.py for the full reasoning.
ENABLE_REFLECTION_SHORTCUT=true
REFLECTION_SHORTCUT_CONFIDENCE_FLOOR=0.15

# Hybrid RAG + CAG — give the LLM every chunk of a small-enough document
# scope instead of a similarity-ranked subset. See config.py for the full
# reasoning; budget is a word-count proxy, not a real tokenizer.
ENABLE_CAG=true
CAG_TOKEN_BUDGET=6000

# ── Caching ──────────────────────────────────────────────────────────
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=300
CACHE_DIR=./cache
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./exam_prep_bot.db

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
# Separate error-only sink for alerting/tailing without DEBUG/INFO noise.
ERROR_LOG_FILE=./logs/error.log
# Rotation/retention/compression — previously hardcoded, now tunable here.
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_COMPRESSION=zip
# Newline-delimited JSON (loguru serialize=True) instead of the human-
# readable text format — turn on when feeding a log-aggregation pipeline
# (Loki/ELK/CloudWatch/Datadog) that wants structured fields, not regex.
LOG_JSON=false
# Truncate user query text to 80 chars (+ real length) before logging it,
# instead of the full text — raw query text in the log file was retrievable
# by any holder of the shared, frontend-exposed API key via /api/logs/tail.
# Only disable in a trusted single-operator environment that wants full-text
# debug logs.
LOG_REDACT_USER_CONTENT=true

# ── Development ──────────────────────────────────────────────────────
DEVELOPMENT_MODE=true

# ── Authentication ───────────────────────────────────────────────────
# Protects mutating/sensitive endpoints (upload, delete, reset, /logs/tail,
# batch, ask/query, history) with an X-API-Key header. Secure by default: if
# left blank, a random key is generated at startup and printed to the logs —
# set a fixed value here so the key stays stable across restarts.
API_AUTH_ENABLED=true
APP_API_KEY=

# If true, the server embeds the active key into the page it serves at "/" so
# the bundled UI needs no manual key entry. Fine for a private/single-tenant
# deployment (anyone who can reach the page can already reach the API); set
# to false — and build real per-user login — before this has independent
# customers who shouldn't see each other's, or your, credentials.
EXPOSE_API_KEY_TO_FRONTEND=true

# A second, operator-only credential for endpoints that must not be
# reachable with the same key the frontend embeds in every page (above) —
# currently GET /api/logs/tail and GET /api/metrics. Leave blank to disable
# those routes entirely rather than falling back to the public key.
ADMIN_API_KEY=

# ── Rate Limiting ────────────────────────────────────────────────────
# Applies to /api/ask, /api/query, and /api/batch — the endpoints that call
# the LLM provider and cost real money per request.
RATE_LIMIT_PER_MINUTE=30
